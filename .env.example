HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=data/store.sqlite
# For deployment set NODE_ENV=production, HOST=0.0.0.0, APP_ORIGIN=https://your-domain

# Supabase Configuration
# Frontend Vite Variables (import.meta.env.VITE_SUPABASE_...)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Node Variables (process.env.SUPABASE_...)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=

# Enable UPI/card checkout only after configuring all three server-only values.
# Use test keys first. Never add these secrets to VITE_ variables or commit .env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Verified UPI/card checkout. COD remains available without gateway keys.
CHECKOUT_PAYMENT_MODE=online
# Never use preference mode for verified website payments.
